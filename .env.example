# Copy to backend/.env for local development. Never commit real values.

# --- backend ---
APP_ENV=development
DATABASE_URL=postgresql://attendai:attendai@localhost:5432/attendai
# Required in production: 32+ random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=
# Only needed when the frontend is served from a different origin than the API.
CORS_ORIGINS=
FRONTEND_ORIGIN=
# Cookie settings (COOKIE_SECURE defaults to true when APP_ENV=production).
COOKIE_SECURE=
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=12
# Uploads
MAX_UPLOAD_MB=5
MAX_UPLOAD_ROWS=20000
# Analytics policy
TARGET_PERCENTAGE=75
WARNING_BAND_POINTS=5
TREND_RECENT_PERIODS=2
TREND_THRESHOLD_POINTS=5
DEFAULT_PLANNED_CLASSES=60
# Demo
SEED_DEMO_DATA=false
DEMO_MODE=false
DEMO_PASSWORD=Demo@2026
# Path to the built frontend; when set, FastAPI serves the SPA too.
STATIC_DIR=

# --- frontend (build time) ---
# Leave unset for same-origin deployments (default "/api").
VITE_API_BASE_URL=
